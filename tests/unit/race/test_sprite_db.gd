extends TestCase
## SpriteDB with the vehicle extensions of docs/fahrzeug-darstellung.md §1 (grid_cols, yaw_deg, pivot,
## projection/camera/supersample, render "box" with parts/faces/lights), backward compatible with the first
## manifest version; the debug overlay (--sprite-manifest, aliases) and the test fixtures
## (tests/fixtures/sprites, generated by tests/fixtures/make_fixtures.py).

const FIXTURES := "res://tests/fixtures/sprites/manifest.json"
const LEGACY := "res://tests/fixtures/legacy/manifest.json"


func _db() -> Node:
	return (load("res://scripts/core/sprite_db.gd") as GDScript).new()


## The first manifest version (tests/fixtures/legacy): one row per layer, the angle names l2/l1/c/r1/r2,
## yaw_deg as a dictionary or missing.
func test_old_manifest_still_works() -> void:
	var db := _db()
	assert_true(db.call("load_manifest", LEGACY), "Manifest im alten Format geladen")
	var id := "traffic/sedan_blue"
	var cs: Vector2 = db.call("cell_size", id)
	assert_eq(db.call("grid_cols", id), 5, "grid_cols = Anzahl Winkel")
	assert_eq(db.call("region", id, "c", "base"), Rect2(2.0 * cs.x, 0.0, cs.x, cs.y), "c/base wie bisher")
	assert_eq(db.call("region", id, "r1", "tail"), Rect2(3.0 * cs.x, cs.y, cs.x, cs.y), "r1/tail wie bisher")
	assert_eq(db.call("region", id, "c", "beacon_a"), Rect2(), "fehlende Ebene")
	assert_eq(Array(db.call("yaw_list", id)), [-25.0, -12.0, 0.0, 12.0, 25.0], "yaw_deg als Wörterbuch")
	assert_eq(db.call("projection", id), "ortho", "Standard: ortho")
	assert_eq(db.call("pivot", id), "rear", "Standard: Drehung um das Heck")
	assert_eq(db.call("render_mode", id), "sprite", "Standard: Sprite")
	assert_eq(db.call("nearest_angle_index", id, -4.6), 2, "nächster Winkel zu -4,6°")
	assert_eq(db.call("nearest_angle_index", id, -19.0), 0, "nächster Winkel zu -19°")
	assert_eq(db.call("supersample", id), 1.0, "ortho: supersample 1")
	var pol := "police/de"
	var pcs: Vector2 = db.call("cell_size", pol)
	assert_eq(Array(db.call("yaw_list", pol)), [-25.0, -12.0, 0.0, 12.0, 25.0], "ohne yaw_deg: aus den alten Namen")
	assert_eq(db.call("region", pol, "l1", "beacon_b"), Rect2(1.0 * pcs.x, 4.0 * pcs.y, pcs.x, pcs.y), "l1/beacon_b wie bisher")
	var tree := "props/tree_oak"
	assert_eq(db.call("region", tree, "c", "base"), Rect2(0.0, 0.0, 256.0, 320.0), "Requisit mit einer Zelle")
	assert_eq(db.call("region", tree, "r1", "base"), Rect2(0.0, 0.0, 256.0, 320.0), "fehlender Winkel -> c")
	db.free()


## The real manifest (whatever version the sprite pipeline delivered): every set has a yaw per angle, every
## sprite set its "c"/base cell inside the sheet raster.
func test_real_manifest_is_consistent() -> void:
	var db := _db()
	var n := 0
	for id: String in db.get("sets"):
		var yaws: PackedFloat32Array = db.call("yaw_list", id)
		assert_eq(yaws.size(), int(db.call("angle_count", id)), "%s: ein Winkel je Eintrag" % id)
		if db.call("is_box", id):
			continue
		var r: Rect2 = db.call("region", id, "c", "base")
		assert_true(r.size.x > 0.0 and r.size.y > 0.0, "%s: Zelle c/base" % id)
		n += 1
	assert_true(n > 50, "Sets geprüft (%d)" % n)
	db.free()


func test_yaw_from_names_and_lists() -> void:
	var sdb: GDScript = load("res://scripts/core/sprite_db.gd")
	assert_eq(Array(sdb.call("parse_yaws", {"angles": ["l2", "l1", "c", "r1", "r2"]})), [-25.0, -12.0, 0.0, 12.0, 25.0], "alte Namen ohne yaw_deg")
	assert_eq(Array(sdb.call("parse_yaws", {"angles": ["l24", "l3", "c", "r3", "r24"]})), [-24.0, -3.0, 0.0, 3.0, 24.0], "Namen l<n>/r<n>")
	assert_eq(Array(sdb.call("parse_yaws", {"angles": ["a", "c", "b"], "yaw_deg": [-7.5, 0.0, 7.5]})), [-7.5, 0.0, 7.5], "yaw_deg als Liste (Vertrag)")
	assert_eq(sdb.call("nearest_yaw_index", PackedFloat32Array([-6.0, -3.0, 0.0, 3.0]), -4.4), 1, "nächster Winkel")
	assert_eq(sdb.call("nearest_yaw_index", PackedFloat32Array(), 1.0), -1, "leere Liste")
	assert_eq(sdb.call("cell_grid_pos", 50, 9), Vector2i(5, 5), "Zelle 50 bei 9 Spalten")
	assert_eq(sdb.call("cell_grid_pos", 4, 5), Vector2i(4, 0), "altes Layout")
	var meta: Dictionary = sdb.call("derive_meta", {"angles": ["c"], "projection": "perspective", "supersample": 2.0})
	assert_eq(meta["pivot"], "center", "perspektivisch: Drehung um die Mitte")
	assert_eq(meta["supersample"], 2.0, "supersample")


## Fixtures: 17-angle ortho car in a grid, 21-angle perspective player, truck as box.
func test_fixture_sets() -> void:
	var db := _db()
	assert_true(db.call("load_manifest", FIXTURES), "Testdaten-Manifest geladen")
	var car := "fixture/car17"
	assert_eq(db.call("angle_count", car), 17, "17 Winkel")
	assert_eq(db.call("grid_cols", car), 9, "9 Spalten")
	var cs: Vector2 = db.call("cell_size", car)
	assert_eq(db.call("cell_region", car, 16, "brake"), Rect2(5.0 * cs.x, 5.0 * cs.y, cs.x, cs.y), "Zelle 2*17+16 = 50 -> Spalte 5, Zeile 5")
	assert_eq(db.call("region", car, "c", "base"), Rect2(8.0 * cs.x, 0.0, cs.x, cs.y), "c = Index 8")
	assert_eq(db.call("resolve_angle", car, "r1"), "r12", "alter Name r1 = 12°")
	assert_eq(db.call("resolve_angle", car, "l2"), "l24", "alter Name l2 = -25° -> nächster -24°")
	assert_eq(db.call("nearest_angle_index", car, 4.0), 9, "4° -> 3°")
	var tex: Texture2D = db.call("texture", car)
	assert_true(tex != null, "Sheet ladbar")
	if tex != null:
		assert_eq(tex.get_size(), Vector2(9.0 * cs.x, 6.0 * cs.y), "Sheet-Größe = Raster")
	var pl := "fixture/player21"
	assert_eq(db.call("projection", pl), "perspective", "Spieler perspektivisch")
	assert_eq(db.call("pivot", pl), "center", "Drehung um die Mitte")
	assert_near(float(db.call("supersample", pl)), 1.25, 1e-6, "supersample")
	assert_near(float((db.call("camera", pl) as Dictionary).get("distance_m", 0.0)), float(ConfigLoader.lookup(cfg(), "render.camera_distance_m", 9.0)), 1e-6, "Kamera = Spielkamera")
	assert_eq(Array(db.call("yaw_list", pl)).size(), 21, "21 Winkel")
	assert_near(float((db.call("yaw_list", pl) as PackedFloat32Array)[0]), -20.0, 1e-6, "von -20°")
	var tr := "fixture/truck_box"
	assert_true(db.call("is_box", tr), "Lkw als Quader")
	assert_eq(db.call("region", tr, "c", "base"), Rect2(), "Quader haben keine Zellen")
	var parts: Array = db.call("box_parts", tr)
	assert_eq(parts.size(), 3, "Auflieger, Fahrerhaus, Rahmen")
	var trailer: Dictionary = parts[0]
	assert_eq(trailer["name"], "trailer", "erster Teil")
	assert_true((trailer["faces"] as Dictionary)["rear"] is Rect2, "Flächen als Rect2")
	var lights: Dictionary = db.call("box_lights", tr)
	assert_eq(((lights["tail"] as Array)[0] as Dictionary)["part"], 0, "Rücklicht am Auflieger")
	db.free()


## The drawn box = the collision box: the parts span exactly object length x width around the centre
## (TrafficSystem takes length/width from "object"), for the fixture and every box set of the real manifest.
func test_box_parts_span_the_collision_box() -> void:
	var paths: Array[String] = [FIXTURES]
	var n := 0
	for path in paths:
		var db := _db()
		db.call("load_manifest", path)
		db.call("merge_manifest", "res://assets/sprites/manifest.json")
		for id: String in db.get("sets"):
			if not db.call("is_box", id):
				continue
			var obj: Dictionary = db.call("object_size", id)
			var z0 := INF
			var z1 := -INF
			var x0 := INF
			var x1 := -INF
			for p: Dictionary in db.call("box_parts", id):
				z0 = minf(z0, float(p["z0"]))
				z1 = maxf(z1, float(p["z1"]))
				x0 = minf(x0, float(p["x0"]))
				x1 = maxf(x1, float(p["x1"]))
			assert_near(z0, -float(obj["length_m"]) * 0.5, 0.05, "%s: Heck" % id)
			assert_near(z1, float(obj["length_m"]) * 0.5, 0.05, "%s: Front" % id)
			assert_near(x0, -float(obj["width_m"]) * 0.5, 0.05, "%s: links" % id)
			assert_near(x1, float(obj["width_m"]) * 0.5, 0.05, "%s: rechts" % id)
			n += 1
		db.free()
	assert_true(n >= 1, "Quader-Sets geprüft (%d)" % n)


## Debug overlay: merged over a manifest (here the old-format one); aliases re-point existing sets to fixtures
## but keep their role (tags); sets not named stay as they are.
func test_overlay_and_aliases() -> void:
	var db := _db()
	db.call("load_manifest", LEGACY)
	var before: int = (db.get("sets") as Dictionary).size()
	assert_true(db.call("merge_manifest", FIXTURES), "Zusatz-Manifest")
	assert_true(db.call("has_set", "fixture/car17"), "Testdaten dazu")
	assert_eq((db.get("sets") as Dictionary).size(), before + 4, "Sets zusammengeführt")
	assert_true(db.call("is_box", "traffic/truck_white"), "Alias traffic/truck_* -> Quader-Lkw")
	var tags: Array = db.call("get_set", "traffic/truck_white").get("tags", [])
	assert_true(tags.has("traffic") and tags.has("heavy"), "Alias behält seine Rolle (Tags)")
	assert_eq(db.call("projection", "player/limousine"), "perspective", "Alias player/* -> perspektivisch")
	assert_true(db.call("texture", "traffic/truck_white") != null, "Alias lädt das Testdaten-Sheet")
	assert_eq(db.call("grid_cols", "traffic/sedan_blue"), 9, "Alias traffic/sedan_* -> 17 Winkel")
	var ptags: Array = db.call("get_set", "police/de").get("tags", [])
	assert_true(db.call("has_layer", "police/de", "beacon_a") and ptags.has("police"), "Alias police/* mit Blaulicht, Rolle bleibt")
	assert_eq(db.call("grid_cols", "props/tree_oak"), 1, "nicht genannte Sets unverändert")
	assert_eq(db.call("region", "props/tree_oak", "c", "base"), Rect2(0.0, 0.0, 256.0, 320.0), "Requisit unverändert")
	db.free()
