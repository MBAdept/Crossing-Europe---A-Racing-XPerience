+class_name Showroom3D
+extends Control
+## SPIKE v0.8.0 – real-time 3D showroom of the vehicle selection in the graphics mode "Modern": the car's glTF model
+## on a turntable in its own small 3D world (SubViewport, transparent background – the menu background shows
+## through), lit by a key light with shadow, a fill light and two rim lights in the UI accent colours; reflections
+## from a small procedural studio sky. Lives inside CarShowcase (same place, same API), which keeps drawing the
+## sprite when a car has no model.
+## The SubViewport is sized in PHYSICAL pixels (design size × the window's stretch scale): with the stretch mode
+## canvas_items a SubViewportContainer with `stretch` would render 660×400 and scale that up softly in a 1080p window.
+
+const MODEL_DIR := "res://assets/models3d/player/"
+const TURN_DEG_S := 14.0
+const START_YAW_DEG := -148.0        ## 3/4 front view like the showroom sprites
+const SLIDE_PX := 120.0
+
+var vehicle_id := ""
+var viewport: SubViewport
+var msaa := Viewport.MSAA_4X
+var shadows := true
+var turn := true                     ## false: frozen (screenshots, tests)
+var _view: TextureRect
+var _pivot: Node3D
+var _car: Node3D
+var _cam: Camera3D
+var _anim := 1.0
+var _dir := 1.0
+var _yaw := START_YAW_DEG
+var _models: Dictionary = {}         ## id -> PackedScene (loaded once)
+var last_bounds := AABB()
+
+
+static func model_path(id: String) -> String:
+	return MODEL_DIR + id + ".glb"
+
+
+static func has_model(id: String) -> bool:
+	return ResourceLoader.exists(model_path(id))
+
+
+func _ready() -> void:
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	viewport = SubViewport.new()
+	viewport.own_world_3d = true
+	viewport.transparent_bg = true
+	if CliArgs.has("showroom-msaa"):
+		msaa = int(CliArgs.get_float("showroom-msaa", 2.0)) as Viewport.MSAA
+	if CliArgs.has("showroom-no-shadow"):
+		shadows = false
+	if CliArgs.has("showroom-still"):
+		turn = false
+	viewport.msaa_3d = msaa
+	viewport.render_target_update_mode = SubViewport.UPDATE_WHEN_VISIBLE
+	viewport.positional_shadow_atlas_size = 1024
+	add_child(viewport)
+	_build_world()
+	_view = TextureRect.new()
+	_view.texture = viewport.get_texture()
+	_view.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
+	_view.stretch_mode = TextureRect.STRETCH_SCALE
+	_view.mouse_filter = Control.MOUSE_FILTER_IGNORE
+	_view.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(_view)
+	resized.connect(_fit)
+	get_viewport().size_changed.connect(_fit)
+	_fit()
+
+
+## Render size = this control's size in physical pixels (stretch scale of the window), at least 16 px.
+func _fit() -> void:
+	if viewport == null or not is_inside_tree():
+		return
+	var scale := get_viewport().get_stretch_transform().get_scale()
+	if CliArgs.has("showroom-naive"):
+		scale = Vector2.ONE   # debug A/B: logical size like SubViewportContainer.stretch (soft in a scaled window)
+	var px := Vector2i((size * scale).round()).max(Vector2i(16, 16))
+	if viewport.size != px:
+		viewport.size = px
+
+
+func _build_world() -> void:
+	var env := Environment.new()
+	env.background_mode = Environment.BG_CLEAR_COLOR          # keeps the viewport transparent
+	var sky_mat := ProceduralSkyMaterial.new()                 # studio "soft box": bright band at the horizon
+	sky_mat.sky_top_color = Color(0.10, 0.12, 0.22)
+	sky_mat.sky_horizon_color = Color(0.85, 0.9, 1.0)
+	sky_mat.ground_bottom_color = Color(0.02, 0.02, 0.05)
+	sky_mat.ground_horizon_color = Color(0.25, 0.2, 0.4)
+	sky_mat.sky_curve = 0.08
+	sky_mat.sun_angle_max = 0.0
+	var sky := Sky.new()
+	sky.sky_material = sky_mat
+	sky.radiance_size = Sky.RADIANCE_SIZE_128
+	env.sky = sky
+	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
+	env.ambient_light_energy = 0.55
+	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
+	env.tonemap_mode = Environment.TONE_MAPPER_FILMIC
+	var we := WorldEnvironment.new()
+	we.environment = env
+	viewport.add_child(we)
+	var key := DirectionalLight3D.new()
+	key.rotation_degrees = Vector3(-48, -35, 0)
+	key.light_energy = 1.5
+	key.shadow_enabled = shadows
+	key.directional_shadow_mode = DirectionalLight3D.SHADOW_ORTHOGONAL
+	key.directional_shadow_max_distance = 14.0
+	viewport.add_child(key)
+	var fill := DirectionalLight3D.new()
+	fill.rotation_degrees = Vector3(-20, 120, 0)
+	fill.light_energy = 0.35
+	viewport.add_child(fill)
+	for spec: Array in [[Vector3(-3.6, 1.2, -2.4), UiTheme.ACCENT], [Vector3(3.6, 1.0, -2.6), UiTheme.ACCENT_2]]:
+		var rim := OmniLight3D.new()
+		rim.position = spec[0]
+		rim.light_color = spec[1]
+		rim.light_energy = 3.0
+		rim.omni_range = 7.0
+		viewport.add_child(rim)
+	# turntable: dark glossy disc with a glowing cyan rim (the 2D platform's look)
+	var disc := MeshInstance3D.new()
+	var cyl := CylinderMesh.new()
+	cyl.top_radius = 3.1
+	cyl.bottom_radius = 3.2
+	cyl.height = 0.08
+	cyl.radial_segments = 64
+	disc.mesh = cyl
+	disc.position.y = -0.04
+	var dm := StandardMaterial3D.new()
+	dm.albedo_color = Color(0.03, 0.04, 0.09)
+	dm.metallic = 0.6
+	dm.roughness = 0.25
+	disc.material_override = dm
+	viewport.add_child(disc)
+	var ring := MeshInstance3D.new()
+	var tor := TorusMesh.new()
+	tor.inner_radius = 3.12
+	tor.outer_radius = 3.2
+	tor.rings = 96
+	tor.ring_segments = 6
+	ring.mesh = tor
+	ring.position.y = 0.01
+	var rm := StandardMaterial3D.new()
+	rm.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	rm.albedo_color = UiTheme.ACCENT_2
+	ring.material_override = rm
+	viewport.add_child(ring)
+	_pivot = Node3D.new()
+	viewport.add_child(_pivot)
+	_cam = Camera3D.new()
+	_cam.fov = 24.0
+	_cam.position = Vector3(0.0, 2.3, 12.2)
+	_cam.look_at_from_position(_cam.position, Vector3(0.0, 0.5, 0.0), Vector3.UP)
+	viewport.add_child(_cam)
+
+
+## Shows the car `id` (true) or reports that it has no model (false – CarShowcase then draws the sprite).
+func show_vehicle(id: String, dir: float = 1.0) -> bool:
+	if not has_model(id):
+		visible = false
+		return false
+	if not _models.has(id):
+		_models[id] = load(model_path(id))
+	var scene: PackedScene = _models[id]
+	if scene == null:
+		visible = false
+		return false
+	if _car != null:
+		_car.queue_free()
+	_car = scene.instantiate()
+	_pivot.add_child(_car)
+	# the models keep the sprite pipeline's origin (traffic: rear edge) – centre the footprint on the turntable
+	var box := _bounds(_car, Transform3D.IDENTITY)
+	_car.position = Vector3(-box.get_center().x, -box.position.y, -box.get_center().z)
+	last_bounds = box
+	vehicle_id = id
+	visible = true
+	_anim = 0.0
+	_dir = dir
+	_yaw = START_YAW_DEG
+	return true
+
+
+## Bounding box of all meshes below `node` in the space of the model root.
+static func _bounds(node: Node, xf: Transform3D) -> AABB:
+	var out := AABB()
+	var first := true
+	var local := xf
+	if node is Node3D:
+		local = xf * (node as Node3D).transform
+	if node is MeshInstance3D and (node as MeshInstance3D).mesh != null:
+		out = local * (node as MeshInstance3D).mesh.get_aabb()
+		first = false
+	for c in node.get_children():
+		var b := _bounds(c, local)
+		if b.size == Vector3.ZERO:
+			continue
+		out = b if first else out.merge(b)
+		first = false
+	return out
+
+
+var _probe_frames := 0
+var _probe_ms: Array[float] = []
+
+
+## Debug (--showroom-probe): after 120 frames prints render statistics of the menu with the 3D showroom.
+func _probe(delta: float) -> void:
+	_probe_frames += 1
+	if _probe_frames == 2:
+		RenderingServer.viewport_set_measure_render_time(viewport.get_viewport_rid(), true)
+		RenderingServer.viewport_set_measure_render_time(get_viewport().get_viewport_rid(), true)
+	if _probe_frames > 30:
+		_probe_ms.append(delta * 1000.0)
+	if _probe_frames == 90:
+		_probe_ms.sort()
+		var rid := viewport.get_viewport_rid()
+		var root := get_viewport().get_viewport_rid()
+		print("SHOWROOM_PROBE ", JSON.stringify({
+			"window": DisplayServer.window_get_size(), "stretch_scale": get_viewport().get_stretch_transform().get_scale(),
+			"subviewport_px": viewport.size, "msaa": viewport.msaa_3d, "bounds_m": last_bounds.size,
+			"frame_ms_median": snappedf(_probe_ms[_probe_ms.size() / 2], 0.01),
+			"draw_calls_frame": Performance.get_monitor(Performance.RENDER_TOTAL_DRAW_CALLS_IN_FRAME),
+			"primitives_frame": Performance.get_monitor(Performance.RENDER_TOTAL_PRIMITIVES_IN_FRAME),
+			"objects_frame": Performance.get_monitor(Performance.RENDER_TOTAL_OBJECTS_IN_FRAME),
+			"sub_draw_calls": RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_VISIBLE, RenderingServer.VIEWPORT_RENDER_INFO_DRAW_CALLS_IN_FRAME),
+			"sub_shadow_draw_calls": RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_SHADOW, RenderingServer.VIEWPORT_RENDER_INFO_DRAW_CALLS_IN_FRAME),
+			"sub_primitives": RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_VISIBLE, RenderingServer.VIEWPORT_RENDER_INFO_PRIMITIVES_IN_FRAME),
+			"sub_cpu_ms": snappedf(RenderingServer.viewport_get_measured_render_time_cpu(rid), 0.01),
+			"sub_gpu_ms": snappedf(RenderingServer.viewport_get_measured_render_time_gpu(rid), 0.01),
+			"root_cpu_ms": snappedf(RenderingServer.viewport_get_measured_render_time_cpu(root), 0.01),
+			"root_gpu_ms": snappedf(RenderingServer.viewport_get_measured_render_time_gpu(root), 0.01),
+			"video_mem_mb": snappedf(Performance.get_monitor(Performance.RENDER_VIDEO_MEM_USED) / 1048576.0, 0.1),
+			"adapter": RenderingServer.get_video_adapter_name(), "vendor": RenderingServer.get_video_adapter_vendor(),
+			"api": RenderingServer.get_video_adapter_api_version(), "type": RenderingServer.get_video_adapter_type(),
+			"tier": Gfx.classify_adapter(RenderingServer.get_video_adapter_name(), RenderingServer.get_video_adapter_vendor()),
+		}))
+
+
+func _process(delta: float) -> void:
+	if not visible:
+		return
+	if CliArgs.has("showroom-probe"):
+		_probe(delta)
+	_anim = minf(1.0, _anim + delta * 4.0)
+	if turn:
+		_yaw = fposmod(_yaw + TURN_DEG_S * delta, 360.0)
+	_pivot.rotation_degrees.y = _yaw
+	var e := 1.0 - pow(1.0 - _anim, 3.0)
+	_view.position.x = (1.0 - e) * SLIDE_PX * _dir
+	_view.modulate.a = e
