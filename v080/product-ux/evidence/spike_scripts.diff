
--- a/scripts/core/gfx.gd	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/core/gfx.gd	2026-11-10 11:43:15.694303555 +0000
@@ -0,0 +1,127 @@
+class_name Gfx
+extends RefCounted
+## SPIKE v0.8.0 – graphics mode ("arcade" | "modern") and the quality settings of Modern. Pure helpers (no
+## autoload access; unit tested): which mode a session really gets, classification of the graphics adapter, quality
+## presets, the "Modern did not survive its last start" marker. Settings (autoload) stores the player's choices.
+
+const ARCADE := "arcade"
+const MODERN := "modern"
+const MODES: Array[String] = [ARCADE, MODERN]
+
+## Quality presets of Modern (order of the option row). "custom" = the single values were changed by hand.
+const PRESET_ORDER: Array[String] = ["deck", "low", "medium", "high", "custom"]
+## Fields of a quality set: shadows 0..3 (Aus, Niedrig, Mittel, Hoch), details 0..2 (Niedrig, Mittel, Hoch),
+## scale = 3D resolution in percent, aa 0..2 (Aus, MSAA 2×, MSAA 4×), effects 0..2 (Aus, Einfach, Voll).
+## Start values – the real numbers behind every step live in config graphics.* (renderer study).
+const PRESETS := {
+	"deck": {"shadows": 1, "details": 1, "scale": 100, "aa": 1, "effects": 1},
+	"low": {"shadows": 0, "details": 0, "scale": 75, "aa": 0, "effects": 0},
+	"medium": {"shadows": 2, "details": 1, "scale": 100, "aa": 1, "effects": 1},
+	"high": {"shadows": 3, "details": 2, "scale": 100, "aa": 2, "effects": 2},
+}
+const QUALITY_KEYS: Array[String] = ["shadows", "details", "scale", "aa", "effects"]
+const SCALE_STEPS: Array[int] = [50, 67, 75, 85, 100, 125, 150]
+
+## Marker file: written before the first Modern scene of a run is built, removed after it has drawn for a while.
+## Still there at the next start = Modern crashed or hung the last time -> this run starts in Arcade with a message.
+const BOOT_MARKER := "user://modern_start.lock"
+
+## Adapter tiers (classify_adapter): "software" = CPU rasteriser (llvmpipe, SwiftShader, WARP …) – Modern is refused
+## as a default and the chooser explains why; "weak" = old integrated graphics – Modern allowed, preset "low",
+## the stage watchdog decides; "deck" = Steam Deck APU; "ok" = everything else.
+const SOFTWARE_HINTS: Array[String] = ["llvmpipe", "softpipe", "swiftshader", "lavapipe", "basic render", "gdi generic", "warp", "software"]
+const DECK_HINTS: Array[String] = ["vangogh", "van gogh", "custom gpu 0405", "custom gpu 0932", "sephiroth"]
+const WEAK_HINTS: Array[String] = ["hd graphics", "uhd graphics 6", "iris graphics", "gma ", "mesa dri intel(r) hd", "radeon hd", "radeon r5", "radeon r7", "geforce gt ", "geforce 9", "geforce 6", "geforce 7", "geforce 8", "videocore", "mali", "adreno", "powervr"]
+
+
+## Tier of a graphics adapter from its name (RenderingServer.get_video_adapter_name()), the API string
+## (get_video_adapter_api_version(), ANGLE shows up there) and whether the game runs under gamescope.
+static func classify_adapter(adapter: String, vendor: String = "", gamescope: bool = false) -> String:
+	var n := (adapter + " " + vendor).to_lower()
+	for h in SOFTWARE_HINTS:
+		if n.contains(h):
+			return "software"
+	for h in DECK_HINTS:
+		if n.contains(h):
+			return "deck"
+	if gamescope and n.contains("amd"):
+		return "deck"
+	for h in WEAK_HINTS:
+		if n.contains(h):
+			return "weak"
+	return "ok"
+
+
+## The mode the chooser preselects / a session without a choice gets: Modern unless the adapter is a software
+## rasteriser or there is no renderer at all (headless).
+static func recommended_mode(tier: String, headless: bool) -> String:
+	return ARCADE if headless or tier == "software" else MODERN
+
+
+## Quality preset recommended for an adapter tier.
+static func recommended_preset(tier: String) -> String:
+	match tier:
+		"deck":
+			return "deck"
+		"weak", "software":
+			return "low"
+	return "medium"
+
+
+## The mode a session really runs in. `chosen` = the player's stored choice ("" = none yet), `cli` = --graphics=…
+## of the command line ("" = none; it wins over everything – tests, screenshots, the rescue switch of a shortcut),
+## `marker` = the boot marker of the last run is still there, `headless` = no renderer.
+## Returns {mode, reason}: reason "" (as chosen), "cli", "headless", "default", "crash_guard".
+static func resolve_mode(chosen: String, cli: String, tier: String, headless: bool, marker: bool) -> Dictionary:
+	if MODES.has(cli):
+		return {"mode": cli, "reason": "cli"}   # also headless: the tests build the Modern scene without a GPU
+	if headless:
+		return {"mode": ARCADE, "reason": "headless"}
+	if marker and chosen != ARCADE:
+		return {"mode": ARCADE, "reason": "crash_guard"}
+	if MODES.has(chosen):
+		return {"mode": chosen, "reason": ""}
+	return {"mode": recommended_mode(tier, headless), "reason": "default"}
+
+
+## Quality set of a preset; "custom" (or an unknown id) returns `custom` completed from "medium".
+static func quality(preset: String, custom: Dictionary = {}) -> Dictionary:
+	if PRESETS.has(preset):
+		return (PRESETS[preset] as Dictionary).duplicate()
+	var q: Dictionary = (PRESETS["medium"] as Dictionary).duplicate()
+	for k in QUALITY_KEYS:
+		if custom.has(k):
+			q[k] = int(custom[k])
+	return sanitized(q)
+
+
+## Preset id whose values equal `q` ("custom" if none does).
+static func preset_of(q: Dictionary) -> String:
+	for id in PRESET_ORDER:
+		if PRESETS.has(id) and sanitized(q) == sanitized(PRESETS[id]):
+			return id
+	return "custom"
+
+
+## Clamps every field into its range (a hand-edited settings file must not break the renderer).
+static func sanitized(q: Dictionary) -> Dictionary:
+	var scale := int(q.get("scale", 100))
+	var best := SCALE_STEPS[0]
+	for s in SCALE_STEPS:
+		if absi(s - scale) < absi(best - scale):
+			best = s
+	return {
+		"shadows": clampi(int(q.get("shadows", 2)), 0, 3), "details": clampi(int(q.get("details", 1)), 0, 2),
+		"scale": best, "aa": clampi(int(q.get("aa", 1)), 0, 2), "effects": clampi(int(q.get("effects", 1)), 0, 2),
+	}
+
+
+## Watchdog verdict for a stage driven in Modern: median and 95th percentile of the frame time in ms over the
+## measured window (after the countdown, without the first seconds). "ok", "slow" (suggest a lower preset once),
+## "too_slow" (offer Arcade after the stage). Thresholds: below ~45 fps median / ~30 fps median.
+static func watchdog_verdict(median_ms: float, p95_ms: float, preset: String) -> String:
+	if median_ms > 33.4 or p95_ms > 66.0:
+		return "too_slow" if preset == "low" else "slow"
+	if median_ms > 22.0:
+		return "slow"
+	return "ok"

--- a/scripts/core/gfx_self_test.gd	1970-01-01 00:00:00.000000000 +0000
+++ b/scripts/core/gfx_self_test.gd	2026-11-10 11:44:21.190672530 +0000
@@ -0,0 +1,72 @@
+class_name GfxSelfTest
+extends RefCounted
+## SPIKE v0.8.0 – "can this computer draw the Modern mode at all?": renders a tiny lit 3D scene (a white sphere under
+## a directional light with a shadow-casting light, a custom-shader quad in a known colour) into a 96×96 SubViewport,
+## reads the picture back and checks a few pixels. A driver that fails to compile the 3D shaders or draws nothing
+## gives a black or uniform picture -> Modern is refused for this run (Arcade with a message). Costs three frames
+## once per start of Modern (behind the loading screen). Headless: skipped ("skipped").
+
+const SIZE := 96
+const QUAD_COLOR := Color(0.1, 0.8, 0.3)
+
+
+## Builds the test scene under `parent`, waits `frames` frames, returns {ok, reason, lit, dark, quad, ms}.
+static func run(parent: Node, break_shader: bool = false, frames: int = 3) -> Dictionary:
+	if DisplayServer.get_name() == "headless":
+		return {"ok": true, "reason": "skipped"}
+	var t0 := Time.get_ticks_usec()
+	var vp := SubViewport.new()
+	vp.size = Vector2i(SIZE, SIZE)
+	vp.own_world_3d = true
+	vp.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+	parent.add_child(vp)
+	var env := Environment.new()
+	env.background_mode = Environment.BG_COLOR
+	env.background_color = Color.BLACK
+	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
+	env.ambient_light_color = Color.BLACK
+	var we := WorldEnvironment.new()
+	we.environment = env
+	vp.add_child(we)
+	var cam := Camera3D.new()
+	cam.position = Vector3(0, 0, 4)
+	vp.add_child(cam)
+	var sun := DirectionalLight3D.new()
+	sun.rotation_degrees = Vector3(-30, 40, 0)
+	sun.shadow_enabled = true
+	vp.add_child(sun)
+	var ball := MeshInstance3D.new()
+	ball.mesh = SphereMesh.new()
+	ball.position = Vector3(-0.9, 0, 0)
+	var white := StandardMaterial3D.new()
+	white.albedo_color = Color.WHITE
+	ball.material_override = white
+	vp.add_child(ball)
+	var quad := MeshInstance3D.new()
+	quad.mesh = QuadMesh.new()
+	quad.position = Vector3(0.9, 0, 0)
+	var sh := Shader.new()
+	# the same kind of shader the Modern road uses: spatial, unshaded, a uniform colour (broken on purpose for the test)
+	sh.code = "shader_type spatial;\nrender_mode unshaded;\nuniform vec4 tint : source_color;\nvoid fragment() { ALBEDO = %s; }\n" % ("vec3(0.0)" if break_shader else "tint.rgb")
+	var sm := ShaderMaterial.new()
+	sm.shader = sh
+	sm.set_shader_parameter("tint", QUAD_COLOR)
+	quad.material_override = sm
+	vp.add_child(quad)
+	for i in frames:
+		await parent.get_tree().process_frame
+	await RenderingServer.frame_post_draw
+	var img := vp.get_texture().get_image()
+	vp.queue_free()
+	if img == null or img.is_empty():
+		return {"ok": false, "reason": "no_image"}
+	# the ball's centre projects to x = 0.5 - 0.9 / (2 · 4 · tan(37.5°)) = 0.353 of the width (camera fov 75°, 4 m away)
+	var lit := img.get_pixel(int(SIZE * 0.353), int(SIZE * 0.5))      # sunlit front of the ball
+	var dark := img.get_pixel(3, 3)                                   # background
+	var q := img.get_pixel(int(SIZE * 0.68), int(SIZE * 0.5))        # shader quad
+	var res := {"lit": snappedf(lit.get_luminance(), 0.01), "dark": snappedf(dark.get_luminance(), 0.01),
+		"quad": "%.2f %.2f %.2f" % [q.r, q.g, q.b], "ms": snappedf((Time.get_ticks_usec() - t0) / 1000.0, 0.1)}
+	var quad_ok := absf(q.r - QUAD_COLOR.r) < 0.12 and absf(q.g - QUAD_COLOR.g) < 0.12 and absf(q.b - QUAD_COLOR.b) < 0.12
+	res["ok"] = lit.get_luminance() > 0.35 and dark.get_luminance() < 0.05 and quad_ok
+	res["reason"] = "" if res["ok"] else ("lighting" if lit.get_luminance() <= 0.35 else ("shader" if not quad_ok else "background"))
+	return res

