+class_name GraphicsChoiceScreen
+extends UiScreen
+## SPIKE v0.8.0 – shown once at the first start of v0.8.0 (no "graphics_mode" in the settings yet; new and existing
+## players alike): two cards "Arcade" and "Modern" with a picture of the same road in each mode. ◀▶ choose, A / Enter
+## confirms; the card recommended for this computer has the focus and a badge (Gfx.recommended_mode: Modern unless the
+## graphics adapter is a software rasteriser). The choice sets graphics mode and sound profile together and is saved;
+## both can be changed any time in the options.
+
+const CARD_W := 560.0
+const CARD_H := 470.0
+
+var cards: Array[Button] = []
+var recommended := Gfx.MODERN
+
+
+func build() -> void:
+	var existing := bool(params.get("existing_player", FileAccess.file_exists(Settings.file_path)))
+	add_header(tr("Grafik wählen"), tr("Neu in v0.8.0: der Modus „Modern“") if existing else tr("Wie soll Crossing Europe aussehen?"))
+	hints = [[["lr"], tr("Wählen")], [["Enter", "pad:A"], tr("Übernehmen")]]
+	var tier := Gfx.classify_adapter(RenderingServer.get_video_adapter_name(), RenderingServer.get_video_adapter_vendor(), Settings.in_gamescope())
+	recommended = Gfx.recommended_mode(tier, DisplayServer.get_name() == "headless")
+	if CliArgs.has("recommend"):
+		recommended = CliArgs.get_string("recommend", recommended)   # debug: screenshots of both cases
+	var texts := {
+		Gfx.ARCADE: [tr("ARCADE"), tr("Das Spiel wie bisher: Pseudo-3D mit Sprites im Stil der 80er-Arcade-Racer, der bisherige Klang.\nLäuft auf jedem Rechner mit 60 Bildern pro Sekunde.")],
+		Gfx.MODERN: [tr("MODERN"), tr("Echtes 3D: feinere Modelle, Sonnenlicht und Schatten, Scheinwerfer bei Nacht, neuer Klang und neue Musik.\nBraucht eine Grafikkarte oder einen Grafikchip ab etwa 2015.")],
+	}
+	for i in Gfx.MODES.size():
+		var id := Gfx.MODES[i]
+		var card := _Card.new()
+		card.mode = id
+		card.title = str(texts[id][0])
+		card.body = str(texts[id][1])
+		card.recommended = id == recommended
+		var path := "res://assets/ui/gfx_preview_%s.png" % id
+		card.picture = load(path) if ResourceLoader.exists(path) else null
+		card.pressed.connect(_choose.bind(id))
+		UiKit.place(self, card, Rect2(64 + i * (CARD_W + 32), 100, CARD_W, CARD_H))
+		cards.append(card)
+	cards[0].focus_neighbor_right = cards[0].get_path_to(cards[1])
+	cards[1].focus_neighbor_left = cards[1].get_path_to(cards[0])
+	var note := UiKit.label(tr("Strecken, Verkehr, Regeln, Spielstand und Bestenlisten sind in beiden Modi gleich. Umschalten jederzeit unter Optionen → Grafik."),
+		UiTheme.F.BODY_MEDIUM, 20, UiTheme.TEXT_DIM, HORIZONTAL_ALIGNMENT_CENTER)
+	UiKit.place(self, note, Rect2(64, 584, 1152, 30))
+	if tier == "software":
+		var warn := UiKit.label(tr("Dieser Rechner zeichnet ohne Grafikkarte (Software-Grafik) – „Modern“ läuft hier voraussichtlich sehr langsam."),
+			UiTheme.F.BODY_BOLD, 20, UiTheme.WARN, HORIZONTAL_ALIGNMENT_CENTER)
