+extends SceneTree
+## SPIKE: GfxSelfTest under a real renderer (Xvfb) – healthy and with a deliberately broken shader; headless: skipped.
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+
+func _run() -> void:
+	var st: GDScript = load("res://scripts/core/gfx_self_test.gd")
+	var good: Dictionary = await st.call("run", root, false)
