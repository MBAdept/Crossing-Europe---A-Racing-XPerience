+	print("SELFTEST ", JSON.stringify({"display": DisplayServer.get_name(), "healthy": good, "broken_shader": bad}))
+	quit(0)

--- a/tests/unit/test_gfx_settings.gd	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/unit/test_gfx_settings.gd	2026-11-10 11:43:29.935220363 +0000
@@ -0,0 +1,113 @@
+extends TestCase
+## SPIKE v0.8.0: graphics mode, quality presets, settings file version 3 and its migration from version 2 / none.
+
+const SettingsScript := preload("res://scripts/core/settings.gd")
+const FILE := "user://test_gfx_settings.json"
+
+
+func _settings(file_content: Variant = null) -> Node:
+	for suffix in ["", ".bak", ".tmp"]:   # JsonFile falls back to the ".bak" of an earlier test
+		if FileAccess.file_exists(FILE + suffix):
+			DirAccess.remove_absolute(ProjectSettings.globalize_path(FILE + suffix))
+	if file_content != null:
+		JsonFile.save_atomic(FILE, file_content)
+	var s: Node = SettingsScript.new()
+	s.set("file_path", FILE)
+	s.call("load_settings")
+	return s
+
+
+func test_adapter_tiers() -> void:
+	assert_eq(Gfx.classify_adapter("llvmpipe (LLVM 20.1.2, 256 bits)", "Mesa"), "software", "llvmpipe")
+	assert_eq(Gfx.classify_adapter("ANGLE (Google, Vulkan 1.3.0 (SwiftShader Device (Subzero)), SwiftShader driver)", "Google"), "software", "SwiftShader")
+	assert_eq(Gfx.classify_adapter("ANGLE (Microsoft, Microsoft Basic Render Driver Direct3D11 vs_5_0 ps_5_0, D3D11)", "Google Inc. (Microsoft)"), "software", "WARP")
+	assert_eq(Gfx.classify_adapter("AMD Custom GPU 0405 (radeonsi, vangogh, LLVM 17.0.6, DRM 3.57, 6.5.0-valve22)", "AMD"), "deck", "Deck LCD")
+	assert_eq(Gfx.classify_adapter("AMD Custom GPU 0932 (radeonsi, sephiroth, LLVM 17, DRM 3.57)", "AMD"), "deck", "Deck OLED")
+	assert_eq(Gfx.classify_adapter("AMD Radeon Graphics (radeonsi, rembrandt)", "AMD", true), "deck", "AMD handheld under gamescope")
+	assert_eq(Gfx.classify_adapter("ANGLE (Intel, Intel(R) HD Graphics 4000 Direct3D11 vs_5_0 ps_5_0, D3D11)", "Google Inc. (Intel)"), "weak", "Intel HD 4000 via ANGLE")
+	assert_eq(Gfx.classify_adapter("NVIDIA GeForce RTX 3060/PCIe/SSE2", "NVIDIA Corporation"), "ok", "RTX")
+	assert_eq(Gfx.classify_adapter("Mesa Intel(R) Xe Graphics (TGL GT2)", "Intel"), "ok", "Xe")
+
+
+func test_mode_of_a_run() -> void:
+	# no choice yet: Modern on real graphics, Arcade on a software rasteriser and without a renderer
+	assert_eq(Gfx.resolve_mode("", "", "ok", false, false), {"mode": "modern", "reason": "default"}, "Standard")
+	assert_eq(Gfx.resolve_mode("", "", "software", false, false), {"mode": "arcade", "reason": "default"}, "Software")
+	assert_eq(Gfx.resolve_mode("modern", "", "ok", true, false), {"mode": "arcade", "reason": "headless"}, "headless")
+	# the player's choice wins over the tier (Modern on llvmpipe is allowed – that is how it is tested here)
+	assert_eq(Gfx.resolve_mode("modern", "", "software", false, false), {"mode": "modern", "reason": ""}, "gewählt")
+	assert_eq(Gfx.resolve_mode("arcade", "", "ok", false, false), {"mode": "arcade", "reason": ""}, "gewählt Arcade")
+	# command line beats the choice (tests, screenshots, bug reports), the marker and a missing renderer
+	assert_eq(Gfx.resolve_mode("arcade", "modern", "ok", false, false), {"mode": "modern", "reason": "cli"}, "CLI")
+	assert_eq(Gfx.resolve_mode("", "modern", "ok", true, false), {"mode": "modern", "reason": "cli"}, "CLI headless (Tests)")
+	assert_eq(Gfx.resolve_mode("modern", "arcade", "ok", false, true), {"mode": "arcade", "reason": "cli"}, "CLI Rettung")
+	# Modern did not survive its last start: this run is Arcade, the choice stays stored
+	assert_eq(Gfx.resolve_mode("modern", "", "ok", false, true), {"mode": "arcade", "reason": "crash_guard"}, "Marker")
+	assert_eq(Gfx.resolve_mode("", "", "ok", false, true), {"mode": "arcade", "reason": "crash_guard"}, "Marker ohne Wahl")
+	assert_eq(Gfx.resolve_mode("arcade", "", "ok", false, true), {"mode": "arcade", "reason": ""}, "Marker, Arcade gewählt")
+
+
+func test_presets_and_custom() -> void:
+	for id in ["deck", "low", "medium", "high"]:
+		assert_eq(Gfx.preset_of(Gfx.quality(id)), id, "Preset " + id)
+	var q := Gfx.quality("medium")
+	q["shadows"] = 0
+	assert_eq(Gfx.preset_of(q), "custom", "ein Wert geändert")
+	assert_eq(Gfx.quality("custom", q)["shadows"], 0, "eigene Werte")
+	assert_eq(Gfx.sanitized({"shadows": 9, "details": -1, "scale": 90, "aa": 7, "effects": 3}),
+		{"shadows": 3, "details": 0, "scale": 85, "aa": 2, "effects": 2}, "Grenzen")
+	assert_eq(Gfx.recommended_preset("deck"), "deck", "Deck")
+	assert_eq(Gfx.recommended_preset("weak"), "low", "schwach")
+	assert_eq(Gfx.recommended_preset("ok"), "medium", "normal")
+
+
+func test_watchdog() -> void:
+	assert_eq(Gfx.watchdog_verdict(15.0, 19.0, "medium"), "ok", "60 fps")
+	assert_eq(Gfx.watchdog_verdict(24.0, 30.0, "medium"), "slow", "~40 fps")
+	assert_eq(Gfx.watchdog_verdict(40.0, 55.0, "medium"), "slow", "25 fps mit Reserve nach unten")
+	assert_eq(Gfx.watchdog_verdict(40.0, 55.0, "low"), "too_slow", "25 fps auf der niedrigsten Stufe")
+
+
+func test_new_player_has_no_choice_and_saves_none() -> void:
+	var s := _settings()
+	assert_eq(str(s.get("graphics_mode")), "", "keine Wahl")
+	assert_true(s.call("save_settings"), "speichern")
+	var d: Dictionary = JsonFile.load_dict(FILE)
+	assert_eq(int(d.get("settings_version", 0)), 3, "Version 3")
+	assert_false(d.has("graphics_mode"), "ohne Wahl nicht gespeichert")
+	assert_false(d.has("gfx_preset"), "ohne Wahl kein Preset")
+	s.free()
+
+
+func test_file_of_v070_keeps_everything_and_gets_no_mode() -> void:
+	# v0.7.0 file: version 2, fullscreen false chosen
+	var s := _settings({"settings_version": 2, "master_volume": 0.5, "fullscreen": false, "player_name": "Maik", "vibration": false})
+	assert_eq(str(s.get("graphics_mode")), "", "bestehender Spieler: keine Wahl -> Auswahl erscheint einmal")
+	assert_false(bool(s.get("fullscreen")), "Vollbild Aus bleibt")
+	assert_true(bool(s.get("fullscreen_chosen")), "… und bleibt eine Wahl (Version 2 zählt weiter)")
+	assert_eq(str(s.get("player_name")), "Maik", "Name")
+	s.set("graphics_mode", "modern")
+	s.set("sound_profile", "modern")
+	s.call("save_settings")
+	var d: Dictionary = JsonFile.load_dict(FILE)
+	assert_eq(str(d.get("graphics_mode", "")), "modern", "Wahl gespeichert")
+	assert_eq(bool(d.get("fullscreen", true)), false, "Vollbild weiter gespeichert")
+	s.free()
+
+
+func test_keys_of_a_newer_version_survive() -> void:
+	var s := _settings({"settings_version": 4, "graphics_mode": "modern", "hdr": true, "gfx_ray": {"a": 1}})
+	s.set("master_volume", 0.3)
+	s.call("save_settings")
+	var d: Dictionary = JsonFile.load_dict(FILE)
+	assert_true(bool(d.get("hdr", false)), "unbekannter Schlüssel bleibt")
+	assert_true(d.has("gfx_ray"), "unbekanntes Wörterbuch bleibt")
+	s.free()
+
+
